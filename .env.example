# URL base (http/https) del Worker de Cloudflare que hospeda el Durable
# Object de la sala (worker/). El cliente la reescribe a wss:// y le agrega
# /room/:codigo. Si se omite, usa el host actual (wss://<host>/room/:codigo).
VITE_WS_WORKER_URL=https://sala-traductor-room-worker.<subdominio>.workers.dev

# URL del motor de traduccion existente: recibe un POST multipart/form-data
# con el campo "audio" (Blob grabado) y "meta" (JSON con sourceLanguage/
# targetLanguage), y responde JSON con { transcript, detectedLanguage,
# translatedText, audioBase64, mimeType }.
VITE_API_TRANSLATE_URL=https://tu-motor-de-traduccion.example.com/api/translate
